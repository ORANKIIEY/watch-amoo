# See https://help.github.com/articles/ignoring-files/

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
frontend/.next/
frontend/out/

# backend
backend/dist/
backend/data/*.db
backend/data/*.db-journal
*.db
*.db-journal

# production
build/

# Large local video assets (keep on disk, do not commit)
frontend/public/videos/**/*.mp4
frontend/public/videos/**/*.webm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
frontend/next-env.d.ts
